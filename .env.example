# ===========================================
# Redressa AI - Environment Variables
# ===========================================
# Copy this to .env.local and fill in real values.
# Never commit .env.local to version control.
# ===========================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Providers ---
# Groq handles core reasoning, classification, and text completion
GROQ_API_KEY=your-groq-api-key-here
# OCR.space handles exclusively Document OCR for Images and restricted PDFs
OCR_SPACE_API_KEY=your-ocr-space-api-key-here

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
